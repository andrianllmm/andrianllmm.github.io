---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import SkillBadge from "@components/SkillBadge.astro";
import { skills as skillData, skillGroups, type SkillKey } from "@data/skills";

const projects = await getCollection("projects", ({ data }) => !data.draft);

// Function to sort skills by number of projects
const sortSkills = (skillKeys: SkillKey[]) => {
  return skillKeys.sort((a, b) => {
    const countA = projects.filter((p) => p.data.skills?.includes(a)).length;
    const countB = projects.filter((p) => p.data.skills?.includes(b)).length;
    return countB - countA || a.localeCompare(b);
  });
};

// Compute "Other" skills not in any group
const groupedSkills = new Set(Object.values(skillGroups).flat());
const otherSkills = Object.keys(skillData).filter(
  (skill) => !groupedSkills.has(skill as SkillKey),
) as SkillKey[];
---

<Layout title="Skills" description="List of skills used.">
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/">Back to home</BackToPrevious>
    </div>

    <div class="space-y-8">
      <h1 class="animate font-semibold">Skills</h1>

      {
        Object.entries(skillGroups).map(([groupName, groupSkills]) => (
          <div class="space-y-4">
            <h2 class="text-lg font-semibold">{groupName}</h2>
            <div class="flex flex-wrap gap-3">
              {sortSkills(groupSkills).map((skill) => (
                <SkillBadge skill={skill} showNum />
              ))}
            </div>
          </div>
        ))
      }

      {
        otherSkills.length > 0 && (
          <div class="space-y-4">
            <h2 class="text-lg font-semibold">Other</h2>
            <div class="flex flex-wrap gap-3">
              {sortSkills(otherSkills).map((skill) => (
                <SkillBadge skill={skill} showNum />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </Container>
</Layout>
