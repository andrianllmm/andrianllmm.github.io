---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import ProjectCard from "@components/ProjectCard.astro";
import WorkCard from "@components/WorkCard.astro";
import SkillBadge from "@components/SkillBadge.astro";
import { skills, type SkillKey } from "@data/skills";
import { projects as allProjects } from "@data/projects";
import { work as allWork } from "@data/work";

export async function getStaticPaths() {
  return (Object.keys(skills) as SkillKey[]).map((skill) => ({
    params: { id: skill },
    props: {
      projects: allProjects.filter(
        (p) => !p.draft && p.skills?.includes(skill),
      ),
      work: allWork.filter((w) => w.skills?.includes(skill)),
    },
  }));
}

const { id } = Astro.params as { id: SkillKey };
const { projects, work } = Astro.props;

const sortedProjects = [...projects].sort((a, b) => {
  const aEnd = a.endDate;
  const bEnd = b.endDate;
  if (aEnd === undefined && bEnd !== undefined) return -1;
  if (bEnd === undefined && aEnd !== undefined) return 1;
  if (aEnd !== undefined && bEnd !== undefined) {
    const endCompare = new Date(bEnd).getTime() - new Date(aEnd).getTime();
    if (endCompare !== 0) return endCompare;
  }
  return new Date(a.startDate).getTime() - new Date(b.startDate).getTime();
});

const hasAny = sortedProjects.length > 0 || work.length > 0;
---

<Layout
  title={`Skill: ${skills[id].name}`}
  description={`Projects and work involving: ${skills[id].name}`}
>
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/skills">All skills</BackToPrevious>
    </div>
    <div class="space-y-8" data-pagefind-ignore>
      <h1 class="animate flex items-center gap-1 font-semibold">
        Involving <SkillBadge skill={id} showNum class="border-none" />
      </h1>

      {
        hasAny ? (
          <>
            {sortedProjects.length > 0 && (
              <div class="space-y-4">
                <h2 class="text-lg font-semibold">Projects</h2>
                <ul class="animate grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {sortedProjects.map((project) => (
                    <li>
                      <ProjectCard project={project} />
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {work.length > 0 && (
              <div class="space-y-4">
                <h2 class="text-lg font-semibold">Work</h2>
                <ul class="not-prose flex flex-col gap-4">
                  {work.map((item) => (
                    <li>
                      <WorkCard item={item} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ) : (
          <div class="my-4 flex flex-col items-center justify-center gap-2">
            <p class="animate text-muted-foreground text-center text-4xl font-bold">
              （￣～￣;）
            </p>
            <p class="animate text-muted-foreground text-center">
              Nothing yet, probably still learning...
            </p>
          </div>
        )
      }
    </div>
  </Container>
</Layout>
