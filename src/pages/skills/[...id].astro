---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SkillBadge from "@components/SkillBadge.astro";
import { skills, type SkillKey } from "@data/skills";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  const paths = (Object.keys(skills) as SkillKey[]).map((skill) => ({
    params: { id: skill },
    props: {
      projects: projects.filter((project) =>
        project.data.skills?.includes(skill),
      ),
    },
  }));

  return paths;
}

const { id } = Astro.params as { id: SkillKey };
const { projects } = Astro.props;

// Sort projects by date, most recent first
const sortedProjects = projects
  .filter((project) => !project.data.draft)
  .sort((a, b) => {
    const aEnd = a.data.endDate;
    const bEnd = b.data.endDate;
    if (aEnd === undefined && bEnd !== undefined) return -1; // a is ongoing
    if (bEnd === undefined && aEnd !== undefined) return 1; // b is ongoing
    if (aEnd !== undefined && bEnd !== undefined) {
      const endCompare = bEnd.getTime() - aEnd.getTime();
      if (endCompare !== 0) return endCompare;
    }
    return a.data.startDate.getTime() - b.data.startDate.getTime();
  });
---

<Layout
  title={`Skill: ${skills[id].name}`}
  description={`Projects with the skill: ${skills[id].name}`}
>
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/skills">All skills</BackToPrevious>
    </div>
    <div class="space-y-6" data-pagefind-ignore>
      <h1 class="animate flex items-center gap-1 font-semibold">
        Projects involving <SkillBadge skill={id} showNum class="border-none" />
      </h1>

      {
        sortedProjects.length > 0 ? (
          <ul class="animate grid grid-cols-1 gap-4 sm:grid-cols-2">
            {sortedProjects.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="animate text-muted">
            No projects yet, probably still learning :)
          </p>
        )
      }
    </div>
  </Container>
</Layout>
