---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SkillBadge from "@components/SkillBadge.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  // Get unique skills
  const skills = [
    ...new Set(projects.flatMap((project) => project.data.skills || [])),
  ];

  // Create paths for each skill
  return skills.map((skill) => ({
    params: { id: skill },
    props: {
      projects: projects.filter((project) =>
        project.data.skills?.includes(skill),
      ),
    },
  }));
}

const { id } = Astro.params;
const { projects } = Astro.props;

// Sort projects by date, most recent first
const sortedProjects = projects
  .filter((project) => !project.data.draft)
  .sort((a, b) => {
    const aEnd = a.data.endDate;
    const bEnd = b.data.endDate;
    if (aEnd === undefined && bEnd !== undefined) return -1; // a is ongoing
    if (bEnd === undefined && aEnd !== undefined) return 1; // b is ongoing
    if (aEnd !== undefined && bEnd !== undefined) {
      const endCompare = bEnd.getTime() - aEnd.getTime();
      if (endCompare !== 0) return endCompare;
    }
    return a.data.startDate.getTime() - b.data.startDate.getTime();
  });
---

<Layout title={`Skill: ${id}`} description={`Projects with the skill: ${id}`}>
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/skills">All skills</BackToPrevious>
    </div>
    <div class="space-y-6" data-pagefind-ignore>
      <h1 class="animate flex items-center gap-1 font-semibold">
        Projects involving {
          (<SkillBadge skill={id} showNum class="border-none" />)
        }
      </h1>
      <ul class="animate grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          sortedProjects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Layout>
