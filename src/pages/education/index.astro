---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import EducationCard from "@components/EducationCard.astro";
import DegreeCard from "@components/DegreeCard.astro";
import { EDUCATION } from "@consts";
import { education, educationProfiles } from "@data/education";
import Badge from "@components/Badge.astro";

const sortByRecency = (
  a: (typeof education)[number],
  b: (typeof education)[number],
) => {
  const aEnd = a.endDate ? new Date(a.endDate).getTime() : 0;
  const bEnd = b.endDate ? new Date(b.endDate).getTime() : 0;

  if (bEnd !== aEnd) return bEnd - aEnd;

  const aStart = a.startDate ? new Date(a.startDate).getTime() : 0;
  const bStart = b.startDate ? new Date(b.startDate).getTime() : 0;

  return bStart - aStart;
};

const degrees = education
  .filter((item) => item.category === "Degree")
  .sort(sortByRecency);
const sortedEducation = education
  .filter((item) => item.category !== "Degree")
  .sort(sortByRecency);
---

<Layout title={EDUCATION.TITLE} description={EDUCATION.DESCRIPTION}>
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/">Back to home</BackToPrevious>
    </div>

    <div class="space-y-6">
      <h1 class="animate font-semibold">Education</h1>

      <p class="animate text-muted-foreground">
        A list of my formal education, online courses, and certifications.
      </p>

      <div class="mb-4 flex gap-2">
        {
          educationProfiles.map((profile) => (
            <a href={profile.url} target="_blank" rel="noopener noreferrer">
              <Badge iconName={profile.icon}>{profile.platform}</Badge>
            </a>
          ))
        }
      </div>

      {
        degrees.length > 0 && (
          <ul class="not-prose flex flex-col gap-3 space-y-2">
            {degrees.map((item) => (
              <li>
                <DegreeCard item={item} />
              </li>
            ))}
          </ul>
        )
      }

      {
        sortedEducation.length > 0 && (
          <div class="space-y-2">
            <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {sortedEducation.map((item) => (
                <li>
                  <EducationCard item={item} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Container>
</Layout>
