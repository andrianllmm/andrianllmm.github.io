---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import TagBadge from "@components/TagBadge.astro";
import { tags as tagDefinitions } from "@data/tags";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const tags = Object.keys(tagDefinitions)
  .map((tag) => ({
    tag,
    count: posts.filter((post) => post.data.tags?.includes(tag)).length,
  }))
  .sort((a, b) => {
    return b.count - a.count || a.tag.localeCompare(b.tag);
  });
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/">Back to home</BackToPrevious>
    </div>

    <div class="space-y-6">
      <h1 class="animate font-semibold">Tags</h1>

      {
        tags.length > 0 ? (
          <div class="animate flex flex-wrap gap-3">
            {tags.map(({ tag, count }) => (
              <TagBadge tag={tag} count={count} showNum />
            ))}
          </div>
        ) : (
          <p class="animate text-muted-foreground">No tags available.</p>
        )
      }
    </div>
  </Container>
</Layout>
