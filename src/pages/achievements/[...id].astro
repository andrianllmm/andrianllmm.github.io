---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import SkillBadge from "@components/SkillBadge.astro";
import RelatedContent from "@components/RelatedContent.astro";
import { achievements } from "@data/achievements";
import { resolveRelatedContent } from "@lib/relatedContent";

export async function getStaticPaths() {
  return achievements
    .filter((a) => !a.draft)
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .map((achievement) => ({
      params: { id: achievement.id },
      props: achievement,
    }));
}

const achievement = Astro.props;
const { posts, caseStudies } = await resolveRelatedContent(
  achievement.relatedPosts,
  achievement.relatedCaseStudies,
);
---

<Layout
  title={achievement.title}
  description={achievement.description || "An achievement."}
>
  <Container>
    <div class="animate">
      <BackToPrevious href="/achievements">Back to achievements</BackToPrevious>
    </div>

    <div class="animate my-10 space-y-1">
      <div
        class="text-muted-foreground animate flex flex-wrap items-center gap-2"
      >
        <div class="text-accent-foreground text-sm font-medium">
          {achievement.position}
        </div>
        &bull;
        <div class="text-sm">
          {achievement.type}
        </div>
        &bull;
        <div class="text-sm">
          <FormattedDate date={new Date(achievement.date)} />
        </div>
      </div>

      <h1 class="animate my-3 text-3xl font-semibold">
        {achievement.title}
      </h1>

      {
        achievement.description && (
          <p class="text-muted-foreground">{achievement.description}</p>
        )
      }

      {
        achievement.skills && achievement.skills.length > 0 && (
          <div class="animate mt-2 flex flex-wrap gap-1">
            {achievement.skills.map((skill) => (
              <SkillBadge skill={skill} class="border-none" />
            ))}
          </div>
        )
      }
    </div>

    <div class="animate">
      <RelatedContent posts={posts} caseStudies={caseStudies} />
    </div>
  </Container>
</Layout>
