---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import AchievementCard from "@components/AchievementCard.astro";
import { ACHIEVEMENTS } from "@consts";
import {
  achievements as allAchievements,
  type Achievement,
} from "@data/achievements";

const data = allAchievements.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

type Acc = {
  [year: string]: Achievement[];
};

const achievements = data.reduce((acc: Acc, item) => {
  const year = new Date(item.date).getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(item);
  return acc;
}, {});

const years = Object.keys(achievements).sort(
  (a, b) => parseInt(b) - parseInt(a),
);
---

<Layout title={ACHIEVEMENTS.TITLE} description={ACHIEVEMENTS.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="animate mb-6">
        <BackToPrevious href="/">Back to home</BackToPrevious>
      </div>

      <div class="space-y-6">
        <h1 class="animate font-semibold">Achievements</h1>

        <p class="text-muted-foreground">
          Some of the competitions, awards, and milestones I've picked up over
          the years.
        </p>

        <div class="space-y-4">
          {
            years.map((year) => (
              <section class="animate space-y-4">
                <div class="font-semibold">{year}</div>
                <div>
                  <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {achievements[year].map((item) => (
                      <li>
                        <AchievementCard achievement={item} />
                      </li>
                    ))}
                  </ul>
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </aside>
  </Container>
</Layout>
