---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import WorkCard from "@components/WorkCard.astro";
import { WORK } from "@consts";
import { work as allWork } from "@data/work";

const work = [...allWork].sort((a, b) => {
  const aEnd = a.endDate;
  const bEnd = b.endDate;
  if (aEnd === undefined && bEnd !== undefined) return -1; // a is current
  if (bEnd === undefined && aEnd !== undefined) return 1; // b is current
  if (aEnd !== undefined && bEnd !== undefined) {
    const endCompare = new Date(bEnd).getTime() - new Date(aEnd).getTime();
    if (endCompare !== 0) return endCompare;
  }
  return new Date(b.startDate).getTime() - new Date(a.startDate).getTime();
});
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="animate mb-6">
        <BackToPrevious href="/">Back to home</BackToPrevious>
      </div>

      <div class="space-y-6">
        <h1 class="animate font-semibold">Work</h1>

        <p class="text-muted-foreground">
          A timeline of my professional experience.
        </p>

        <ul class="not-prose flex flex-col gap-4">
          {
            work.map((item) => (
              <li>
                <WorkCard item={item} />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
