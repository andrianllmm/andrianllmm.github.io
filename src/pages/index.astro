---
import {
  PINNED_PROJECTS,
  PINNED_WORK,
  PINNED_ACHIEVEMENTS,
  PINNED_EDUCATION,
  PINNED_SKILLS,
  SITE,
  HOME,
  SOCIALS,
} from "@consts";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { Icon } from "astro-icon/components";
import ProjectCard from "@components/ProjectCard.astro";
import PostCard from "@components/PostCard.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import AchievementCard from "@components/AchievementCard.astro";
import EducationCard from "@components/EducationCard.astro";
import DegreeCard from "@components/DegreeCard.astro";
import SkillBadge from "@components/SkillBadge.astro";
import TagBadge from "@components/TagBadge.astro";
import Badge from "@components/Badge.astro";
import Avatar from "@components/Avatar.astro";
import Contact from "@components/Contact.astro";
import StructuredData from "@components/StructuredData.astro";
import Timeline from "@components/Timeline.astro";
import GithubContributions from "@components/GithubContributions.astro";
import { tags as allTags } from "@data/tags";
import { education } from "@data/education";
import { projects as allProjectsData } from "@data/projects";
import { work as allWorkData } from "@data/work";
import { achievements as allAchievementsData } from "@data/achievements";

const tags = Object.keys(allTags).slice(0, SITE.NUM_TAGS_ON_HOMEPAGE);

const allPosts = (await getCollection("posts")).filter((p) => !p.data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allCaseStudies = (await getCollection("caseStudies")).filter(
  (p) => !p.data.draft,
);

const caseStudies = allCaseStudies
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_CASE_STUDIES_ON_HOMEPAGE);

const work = PINNED_WORK.map((id) =>
  allWorkData.find((w) => w.id === id),
).filter((w): w is (typeof allWorkData)[number] => w !== undefined);

const allProjects = allProjectsData.filter((p) => !p.draft);
const projects = PINNED_PROJECTS.map((id) =>
  allProjects.find((p) => p.id === id),
).filter((p): p is (typeof allProjects)[number] => p !== undefined);

const achievements = PINNED_ACHIEVEMENTS.map((id) =>
  allAchievementsData.find((a) => a.id === id),
).filter((a): a is (typeof allAchievementsData)[number] => a !== undefined);

const skills = PINNED_SKILLS;

const sortByRecency = (
  a: (typeof education)[number],
  b: (typeof education)[number],
) => {
  const aEnd = a.endDate ? new Date(a.endDate).getTime() : Infinity;
  const bEnd = b.endDate ? new Date(b.endDate).getTime() : Infinity;
  if (bEnd !== aEnd) return bEnd - aEnd;
  const aStart = a.startDate ? new Date(a.startDate).getTime() : 0;
  const bStart = b.startDate ? new Date(b.startDate).getTime() : 0;
  return bStart - aStart;
};

const pinnedEducation = PINNED_EDUCATION.map((id) =>
  education.find((item) => item.id === id),
).filter((item): item is (typeof education)[number] => item !== undefined);

const learningDegrees = pinnedEducation
  .filter((item) => item.category === "Degree")
  .sort(sortByRecency);

const stillLearning = pinnedEducation
  .filter((item) => item.category !== "Degree")
  .sort(sortByRecency);

// Create Person structured data
const personData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrian Lloyd Maagma",
  url: Astro.site,
  email: SITE.EMAIL,
  jobTitle: "Computer Science Student",
  description: SITE.DESCRIPTION,
  sameAs: SOCIALS.map((social) => social.HREF),
};

// Create WebSite structured data with search capability
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Andrian Lloyd Maagma",
  description: SITE.DESCRIPTION,
  url: Astro.site,
  author: {
    "@type": "Person",
    name: "Andrian Lloyd Maagma",
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${Astro.site}/#search={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const bio = "...and I make software smarter";

const positions = [
  {
    title: "Bachelor of Science in Computer Science",
    abbr: "BSCS",
    at: "University of the Philippines",
    atLink: "https://upv.edu.ph",
    atAbbr: "UP Visayas",
  },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Fragment slot="head">
    <StructuredData data={personData} />
    <StructuredData data={websiteData} />
  </Fragment>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-24">
        <section>
          <div class="grid grid-cols-5 items-center gap-4">
            <div class="animate col-span-2 sm:col-span-1">
              <Avatar />
            </div>
            <div
              class="animate col-span-3 space-y-1 sm:col-span-4 sm:space-y-2"
            >
              <!-- Name -->
              <h1 class="text-2xl font-semibold sm:text-3xl">
                This is Andrian
              </h1>

              <!-- Bio -->
              <p class="text-muted-foreground text-xs sm:text-sm">
                <i>{bio}</i>
              </p>

              <!-- Current professional position -->
              <p
                class="flex flex-wrap items-center gap-x-1 gap-y-1 text-xs sm:text-sm"
              >
                {
                  positions.map((position, index) => (
                    <>
                      {index > 0 && (
                        <span aria-hidden="true" class="shrink-0">
                          /
                        </span>
                      )}

                      <span class="inline-flex whitespace-nowrap">
                        <abbr title={position.title} class="no-underline">
                          {position.abbr || position.title}
                        </abbr>

                        <span>&nbsp;@&nbsp;</span>

                        <Link href={position.atLink} external>
                          <abbr title={position.at}>
                            {position.atAbbr || position.at}
                          </abbr>
                        </Link>
                      </span>
                    </>
                  ))
                }
              </p>

              <!-- Contact -->
              <nav aria-label="Contact links" class="mt-2">
                <Contact />
              </nav>
            </div>
          </div>

          <article class="animate space-y-4">
            <p>
              I'm an aspiring <abbr
                title="Artificial Intelligence / Machine Learning Engineer"
                >AI/ML engineer</abbr
              > who enjoys bringing machine learning out of notebooks and into people's
              hands.
            </p>
            <p>
              I'm broadly interested in working across the pipeline, from
              training models to designing the software around them. I'm
              particularly interested in solving problems for underserved
              communities, such as improving the state of Filipino NLP.
            </p>
            <p class="flex flex-wrap items-center">
              I'm always happy to connect, so feel free to
              <Link href={"https://cal.com/andrianllmm"} external>
                <span
                  class="mx-1.5 inline-flex items-center gap-1 underline decoration-dotted"
                >
                  <Icon
                    name="lucide:calendar"
                    class="size-3.5"
                    aria-hidden="true"
                  />
                  reach out
                </span>
              </Link>
              and chat <span class="text-muted-foreground mx-2 font-bold"
                >:D</span
              >
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">Work</h2>
            <Link href="/work">See my experience</Link>
          </div>

          <Timeline items={work} />
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">Projects</h2>
            <Link href="/projects">See all projects</Link>
          </div>

          <div class="animate flex flex-wrap gap-1">
            {
              skills.map((skill) => (
                <SkillBadge skill={skill} class="border-none" />
              ))
            }
            <a
              href="/skills"
              aria-label="See all skills"
              title="See all skills"
            >
              <Badge class="border-none">. . .</Badge>
            </a>
          </div>

          <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
              projects.map((project) => (
                <li>
                  <ProjectCard project={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">Achievements</h2>
            <Link href="/achievements">See all achievements</Link>
          </div>

          <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
              achievements.map((achievement) => (
                <li>
                  <AchievementCard achievement={achievement} />
                </li>
              ))
            }
          </ul>
        </section>

        {
          (learningDegrees.length > 0 || stillLearning.length > 0) && (
            <section class="animate space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-y-2">
                <h2 class="text-lg font-semibold">Still learning...</h2>
                <Link href="/education">See education</Link>
              </div>

              {learningDegrees.length > 0 && (
                <ul class="not-prose flex flex-col gap-3">
                  {learningDegrees.map((item) => (
                    <li>
                      <DegreeCard item={item} />
                    </li>
                  ))}
                </ul>
              )}

              {stillLearning.length > 0 && (
                <ul class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {stillLearning.map((item) => (
                    <li>
                      <EducationCard item={item} />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">Latest posts</h2>
            <Link href="/posts">See all posts</Link>
          </div>

          <div class="animate flex flex-wrap gap-1">
            {tags.map((tag) => <TagBadge tag={tag} class="border-none" />)}
            <a href="/tags" aria-label="See all tags" title="See all tags">
              <Badge class="border-none">. . .</Badge>
            </a>
          </div>

          <ul class="not-prose flex flex-col gap-4">
            {
              posts.map((post) => (
                <li>
                  <PostCard post={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">Case studies</h2>
            <Link href="/case-studies">See all case studies</Link>
          </div>

          <ul class="not-prose flex flex-col gap-4">
            {
              caseStudies.map((caseStudy) => (
                <li>
                  <CaseStudyCard caseStudy={caseStudy} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="text-lg font-semibold">I do open source</h2>
            <Link href="https://github.com/andrianllmm" external>
              See my contributions
            </Link>
          </div>

          <GithubContributions username="andrianllmm" />
        </section>
      </div>
    </aside>
  </Container>
</Layout>
