---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import SkillBadge from "@components/SkillBadge.astro";
import TagBadge from "@components/TagBadge.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Contact from "@components/Contact.astro";

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const skills = [
  ...new Set(projects.flatMap((project) => project.data.skills || [])),
].sort((a, b) => {
  // Sort skills by the number of projects they have, descending
  const countA = projects.filter((project) =>
    project.data.skills?.includes(a),
  ).length;
  const countB = projects.filter((project) =>
    project.data.skills?.includes(b),
  ).length;
  return countB - countA || a.localeCompare(b); // Secondary sort by name
});

const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort(
  (a, b) => {
    // Sort tags by the number of posts they have, descending
    const countA = posts.filter((post) => post.data.tags?.includes(a)).length;
    const countB = posts.filter((post) => post.data.tags?.includes(b)).length;
    return countB - countA || a.localeCompare(b); // Secondary sort by name
  },
);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">I'm Andrian</h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                I’m into web dev, UI/UX, data science, and NLP. I’ve picked up a
                lot by building apps, leading design projects, and conducting
                research.
              </p>
            </span>
          </article>
        </section>

        <section class="animate space-y-4">
          <Contact />
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <div class="animate flex flex-wrap gap-2">
            {skills.map((skill) => <SkillBadge skill={skill} />)}
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <div class="animate flex flex-wrap gap-2">
            {tags.map((tag) => <TagBadge tag={tag} />)}
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              posts.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
