---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Container from "@components/Container.astro";
import FormattedDateRange from "@components/FormattedDateRange.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import Link from "@components/Link.astro";
import SkillBadge from "@components/SkillBadge.astro";
import RelatedContent from "@components/RelatedContent.astro";
import { projects } from "@data/projects";
import { resolveRelatedContent } from "@lib/relatedContent";

export async function getStaticPaths() {
  return projects
    .filter((project) => !project.draft)
    .map((project) => ({
      params: { id: project.id },
      props: project,
    }));
}

const project = Astro.props;
const { posts, caseStudies } = await resolveRelatedContent(
  project.relatedPosts,
  project.relatedCaseStudies,
);
---

<Layout title={project.title} description={project.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/projects">Back to projects</BackToPrevious>
    </div>
    <div class="animate my-10 space-y-1">
      <div class="flex flex-wrap justify-between">
        <div class="flex items-center gap-1.5">
          <div class="font-base text-sm">
            <FormattedDateRange
              startDate={new Date(project.startDate)}
              endDate={project.endDate ? new Date(project.endDate) : undefined}
              formatOptions={{ year: "numeric", month: "short" }}
            />
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          {
            (project.demoURL || project.repoURL) && (
              <nav class="flex gap-1">
                {project.demoURL && (
                  <Link
                    href={project.demoURL}
                    external
                    class="flex items-center gap-1"
                  >
                    <Icon name="lucide:external-link" class="h-4 w-4" />
                    <span class="sr-only sm:not-sr-only">demo</span>
                  </Link>
                )}
                {project.demoURL && project.repoURL && <span>/</span>}
                {project.repoURL && (
                  <Link
                    href={project.repoURL}
                    external
                    class="flex items-center gap-1"
                  >
                    <Icon name="lucide:github" class="h-4 w-4" />
                    <span class="sr-only sm:not-sr-only">repo</span>
                  </Link>
                )}
              </nav>
            )
          }
        </div>
      </div>

      <h1 class="my-4 text-3xl font-semibold">
        {project.title}
      </h1>

      <p class="text-muted-foreground">
        {project.description}
      </p>

      {
        project.skills && project.skills?.length > 0 ? (
          <div class="animate flex flex-wrap gap-1">
            {project.skills.map((skill) => (
              <SkillBadge skill={skill} class="border-none" />
            ))}
          </div>
        ) : null
      }
    </div>
    {
      project.image && (
        <div class="animate text-muted my-10 aspect-video overflow-hidden rounded-lg text-xs">
          <img
            src={project.image}
            alt={project.title}
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <div class="animate">
      <RelatedContent posts={posts} caseStudies={caseStudies} />
    </div>
  </Container>
</Layout>
