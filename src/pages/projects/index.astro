---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => {
    const aEnd = a.data.endDate;
    const bEnd = b.data.endDate;
    if (aEnd === undefined && bEnd !== undefined) return -1; // a is ongoing
    if (bEnd === undefined && aEnd !== undefined) return 1; // b is ongoing
    if (aEnd !== undefined && bEnd !== undefined) {
      const endCompare = bEnd.getTime() - aEnd.getTime();
      if (endCompare !== 0) return endCompare;
    }
    return a.data.startDate.getTime() - b.data.startDate.getTime();
  });
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="animate mb-6">
      <BackToPrevious href="/">Back to home</BackToPrevious>
    </div>

    <aside data-pagefind-ignore>
      <div class="space-y-6">
        <h1 class="animate font-semibold">Projects</h1>

        <ul class="animate not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            projects.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
