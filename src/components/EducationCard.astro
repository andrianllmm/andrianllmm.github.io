---
import type { EducationItem } from "@data/education";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const { item } = Astro.props as { item: EducationItem };

let yearDisplay = "";
if (item.startDate) {
  const startYear = new Date(item.startDate).getFullYear();

  if (item.endDate) {
    const endYear = new Date(item.endDate).getFullYear();
    yearDisplay =
      startYear === endYear ? `${startYear}` : `${startYear}–${endYear}`;
  } else {
    yearDisplay = `${startYear}`;
  }
}

const isCompleted =
  !!item.endDate && new Date(item.endDate).getTime() <= Date.now();

const statusIcon = isCompleted
  ? "lucide:circle-check-big"
  : "lucide:circle-dashed";

const provider = item.institution ?? item.provider;

const placeholderIcons = {
  Degree: "lucide:graduation-cap",
  Certification: "lucide:badge-check",
  "Online Course": "lucide:laptop-minimal",
  Workshop: "lucide:hammer",
} as const;

const placeholderIcon =
  placeholderIcons[item.category as keyof typeof placeholderIcons] ??
  "lucide:file-badge";
---

<a
  href={item.url ?? "#"}
  target={item.url ? "_blank" : undefined}
  rel={item.url ? "noopener noreferrer" : undefined}
  class:list={[
    "group block !no-underline",
    !item.url && "pointer-events-none cursor-default",
  ]}
>
  {
    item.image ? (
      <div class="flex aspect-[1.414] w-full items-center justify-center">
        <Image
          src={item.image}
          alt={item.title}
          width={700}
          height={495}
          class="max-h-full w-auto max-w-full rounded-lg shadow-xs transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:shadow-xl hover:shadow-black/10 dark:hover:shadow-black/30"
        />
      </div>
    ) : (
      <div class="border-border/60 bg-muted/20 flex aspect-[1.414] w-full items-center justify-center rounded-lg border border-dashed shadow-xs transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:shadow-xl hover:shadow-black/10 dark:hover:shadow-black/30">
        <Icon name={placeholderIcon} class="text-muted-foreground/35 size-12" />
      </div>
    )
  }

  <div class="px-1 pt-3 text-center">
    <h3 class="line-clamp-2 text-sm leading-snug font-semibold">
      {item.title}
    </h3>

    <div
      class="text-muted-foreground mt-1 flex items-center justify-center gap-1.5 text-[11px]"
    >
      {item.category && <span>{item.category}</span>}

      {
        yearDisplay && (
          <>
            <span>·</span>
            <span>{yearDisplay}</span>
          </>
        )
      }

      <Icon name={statusIcon} class="size-3 shrink-0" />
    </div>

    {provider && <p class="text-muted-foreground mt-1 text-xs">{provider}</p>}
  </div>
</a>
