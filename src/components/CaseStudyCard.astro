---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import { readingTime } from "@lib/utils";

type Props = {
  caseStudy: CollectionEntry<"caseStudies">;
};

const { caseStudy } = Astro.props as Props;
---

<a
  href={`/case-studies/${caseStudy.id}`}
  class:list={[
    "not-prose group flex h-full w-full flex-1 items-start gap-2 rounded-lg border px-4 py-3 sm:items-center sm:gap-3",
    "hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground transition-all duration-300 ease-in-out",
  ]}
>
  {
    caseStudy.data.image && (
      <div class="text-muted aspect-video w-24 overflow-hidden rounded-lg text-xs sm:w-36 md:w-48">
        <Image
          src={caseStudy.data.image}
          alt={caseStudy.data.title}
          class="transition-transform duration-300 ease-in-out group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-1">
    <div class="line-clamp-2 font-semibold">{caseStudy.data.title}</div>
    <div
      class="line-clamp-1 text-sm text-wrap group-hover:line-clamp-6 sm:line-clamp-2"
    >
      {caseStudy.data.description}
    </div>
    <div class="text-muted-foreground mt-0.5 flex gap-1 text-xs">
      {
        caseStudy.data.date && (
          <FormattedDate
            date={caseStudy.data.date}
            formatOptions={{ year: "numeric" }}
          />
        )
      }
      {caseStudy.body && <div>&bull; {readingTime(caseStudy.body)}</div>}
    </div>
  </div>
</a>
