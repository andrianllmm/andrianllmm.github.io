---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  className?: string;
};

const {
  href,
  external,
  underline = true,
  group = false,
  className = "",
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "hover:text-accent-foreground hover:decoration-accent-foreground/60 inline-block text-current decoration-current/30 transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-[0.2rem]",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
