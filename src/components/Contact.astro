---
import { SITE, SOCIALS } from "@consts";
import Link from "@components/Link.astro";
import { Icon } from "astro-icon/components";

const socialIconMapping: Record<string, string> = {
  GitHub: "simple-icons:github",
  "Twitter-X": "simple-icons:x",
  LinkedIn: "simple-icons:linkedin",
  YouTube: "simple-icons:youtube",
};

interface Contact {
  name: string;
  type: string;
  href: string;
  icon: string;
  iconOpen?: string;
}

const CONTACTS: Contact[] = [
  {
    name: "Aklan, Philippines",
    type: "location",
    href: "https://maps.google.com/?q=Aklan, Philippines",
    icon: "lucide:map-pin",
  },
  {
    name: SITE.EMAIL,
    type: "email",
    href: `mailto:${SITE.EMAIL}`,
    icon: "lucide:mail",
    iconOpen: "lucide:mail-open",
  },
  ...SOCIALS.map(({ NAME, HREF }) => ({
    name: NAME,
    type: "social",
    href: HREF,
    icon: socialIconMapping[NAME],
  })),
];
---

<ul class="not-prose flex flex-wrap gap-2">
  {
    CONTACTS.map((contact) => (
      <li class="group flex w-fit items-center gap-1 text-nowrap">
        <Link
          href={contact.href}
          external
          aria-label={
            contact.type === "location"
              ? `Andrian Lloyd Maagma is based in ${contact.name}`
              : contact.type === "email"
                ? `Email Andrian Lloyd Maagma`
                : `Andrian Lloyd Maagma on ${contact.name}`
          }
          class="flex items-center gap-1.5"
        >
          <>
            <Icon
              name={contact.icon}
              class:list={[
                "h-4 w-4 transition-colors duration-300 ease-in-out",
                contact.iconOpen && "group-hover:hidden",
              ]}
            />
            {contact.iconOpen && (
              <Icon
                name={contact.iconOpen}
                class="hidden size-4 transition-opacity duration-300 group-hover:inline"
              />
            )}
          </>
          <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-all delay-100 duration-400 ease-in-out group-hover:max-w-[16rem] group-hover:opacity-100">
            {contact.name}
          </span>
        </Link>
      </li>
    ))
  }
</ul>
