---
import Arrow from "./Arrow.astro";
import Button from "./Button.astro";

type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a href={href} class="not-prose">
  <Button class="group flex flex-nowrap items-center px-2.5 py-1.5">
    <Arrow direction="left" />
    <div class="text-sm">
      <slot />
    </div>
  </Button>
</a>
