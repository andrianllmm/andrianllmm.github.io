---
import Button from "./Button.astro";
import Arrow from "./Arrow.astro";

const { prevPost, nextPost } = Astro.props;
---

<div class="grid grid-cols-2 gap-1.5 sm:gap-3">
  {
    prevPost?.id ? (
      <a href={`/blog/${prevPost?.id}`} class="not-prose no-underline">
        <Button class="group relative w-full justify-center rounded-lg p-2">
          <Arrow
            direction="left"
            class="absolute top-1/2 left-2 size-5 -translate-y-1/2"
          />
          <div class="text-center text-sm">{prevPost?.data.title}</div>
        </Button>
      </a>
    ) : (
      <div class="invisible" />
    )
  }

  {
    nextPost?.id ? (
      <a href={`/blog/${nextPost?.id}`} class="not-prose no-underline">
        <Button class="group relative w-full justify-center rounded-lg p-2">
          <div class="text-center text-sm">{nextPost?.data.title}</div>
          <Arrow
            direction="right"
            class="absolute top-1/2 right-2 size-5 -translate-y-1/2"
          />
        </Button>
      </a>
    ) : (
      <div class="invisible" />
    )
  }
</div>
