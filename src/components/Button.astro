---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  class?: string;
}

const { class: className = "", ...rest } = Astro.props as {
  class?: string;
};
---

<button
  class={cn(
    "p-1 transition-colors flex items-center justify-center gap-1 rounded border duration-300 ease-in-out hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground",
    className,
  )}
  {...rest}
>
  <slot />
</button>
