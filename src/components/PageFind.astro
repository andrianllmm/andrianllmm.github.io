---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<PagefindConfig />
<pagefind-modal id="search" reset-on-close></pagefind-modal>

<script>
  // PageFind.astro is re-rendered on every client-side navigation (it isn't
  // transition:persist'ed), so `#search` is a fresh element each time. Look
  // it up on demand rather than caching it, since this script only runs once.
  function getModal() {
    return document.getElementById("search") as
      | (HTMLElement & { open: () => void; close: () => void })
      | null;
  }

  function openPagefind() {
    getModal()?.open();
  }

  function closePagefind() {
    getModal()?.close();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("#magnifying-glass")) {
      openPagefind();
    } else if (target.closest(".pf-result-link")) {
      closePagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    const isTyping =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (e.key === "/" && !isTyping) {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    }
  });
</script>

<style is:global>
  :root {
    --pf-border-radius: var(--radius-lg);
    --pf-font: var(--font-sans);
    --pf-text: var(--foreground);
    --pf-text-secondary: var(--muted-foreground);
    --pf-text-muted: var(--muted-foreground);
    --pf-background: var(--background);
    --pf-border: var(--border);
    --pf-border-focus: var(--primary);
    --pf-mark: var(--primary);
    --pf-outline-focus: var(--primary);
    --pf-hover: var(--background-accent);
    --pf-skeleton: var(--background-accent);
    --pf-skeleton-shine: var(--background-dim);
    --pf-error-bg: var(--background-accent);
    --pf-error-border: var(--border);
    --pf-error-text: var(--foreground);
    --pf-error-text-secondary: var(--muted-foreground);
  }

  #search .pf-result-title {
    font-weight: 600;
  }
</style>
