---
import type { CollectionEntry } from "astro:content";
import Arrow from "./Arrow.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class:list={[
    "not-prose group relative flex w-full flex-nowrap justify-center rounded-lg border px-4 py-3 pr-10",
    "hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground transition-colors duration-300 ease-in-out",
  ]}
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-semibold">
      {entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>
  <Arrow
    direction="right"
    class="absolute top-1/2 right-2 size-5 -translate-y-1/2"
  />
</a>
