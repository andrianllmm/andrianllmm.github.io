---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

// https://kld.dev/building-table-of-contents/
const { headings, open } = Astro.props;
const toc = buildToc(headings);

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

function buildToc(headings: Heading[]) {
  const toc: any[] = [];
  const parentHeadings = new Map<number, any>();

  for (const h of headings) {
    const heading = { ...h, subheadings: [] };
    parentHeadings.set(heading.depth, heading);

    const parent = parentHeadings.get(heading.depth - 1);
    if (parent) {
      parent.subheadings.push(heading);
    } else {
      toc.push(heading); // no parent? treat as top-level
    }
  }

  return toc;
}
---

<details {...open ? { open: false } : {}} class="animate group rounded">
  <summary
    class:list={[
      "rounded-lg px-3 py-1.5",
      "text-muted-foreground text-sm font-medium",
      "hover:bg-accent focus-visible:bg-accent focus-visible:text-accent-foreground cursor-pointer transition-colors",
      "group-open:bg-accent group-open:rounded-b-none",
    ]}>Table of Contents</summary
  >
  <nav>
    <ul class="py-3">
      {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
    </ul>
  </nav>
</details>
