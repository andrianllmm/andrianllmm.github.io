---
import { Image } from "astro:assets";

const imageClass =
  "blur-[0.25px] sm:blur-[0.1px] delay-50 group-hover:cursor-zoom-in h-full w-full translate-y-2 hover:-translate-y-1 scale-120 group-hover:scale-640 group-hover:blur-none duration-300 ease-in-out transition-transform";
---

<div
  class="text-muted group hover:border-accent h-full w-full overflow-hidden rounded-full border text-xs transition-all delay-50 duration-300 ease-in-out hover:-translate-y-2 hover:border-4"
>
  <a href="/images/avatar.png" target="_blank">
    <Image
      src="/images/avatar.png"
      alt="Avatar"
      class:list={imageClass}
      width="100"
      height="100"
    />
  </a>
</div>
