---
import { cn } from "@lib/utils";
import { skills, type SkillKey, type Skill } from "@data/skills";
import { projects } from "@data/projects";
import { work } from "@data/work";
import Badge from "./Badge.astro";

const {
  skill,
  hideName = false,
  showNum = false,
  class: className = "",
} = Astro.props as {
  skill: SkillKey;
  hideName?: boolean;
  showNum?: boolean;
  class?: string;
};

const skillObj = skills[skill] as Skill | undefined;
const name = skillObj?.name ?? skill;
const icon = skillObj?.icon;

const usageCount = [...projects.filter((p) => !p.draft), ...work].filter(
  (entity) => entity.skills?.includes(skill),
).length;
---

<a href={`/skills/${skill}`}>
  <Badge
    iconName={icon}
    hideName={hideName}
    indicator={showNum && usageCount}
    class={cn("hover:-translate-y-0.75 transition-transform", className)}
  >
    {name}
  </Badge>
</a>
