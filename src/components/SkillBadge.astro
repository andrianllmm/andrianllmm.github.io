---
import { getCollection } from "astro:content";
import { cn } from "@lib/utils";
import { skills, type SkillKey, type Skill } from "@data/skills";
import Badge from "./Badge.astro";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const {
  skill,
  hideName = false,
  showNum = false,
  class: className = "",
} = Astro.props as {
  skill: SkillKey;
  hideName?: boolean;
  showNum?: boolean;
  class?: string;
};

const skillObj = skills[skill] as Skill | undefined;
const name = skillObj?.name ?? skill;
const icon = skillObj?.icon;

const projectCount = projects.filter((project) =>
  project.data.skills?.includes(skill),
).length;
---

<a href={`/skills/${skill}`}>
  <Badge
    iconName={icon}
    hideName={hideName}
    indicator={showNum && projectCount}
    class={cn("hover:-translate-y-0.75 transition-transform", className)}
  >
    {name}
  </Badge>
</a>
