---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { Icon } from "astro-icon/components";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href="/" underline={false} class="rounded">
        <div class="font-semibold">
          <span class="block sm:hidden">
            Andrian
            <span class="sr-only">Andrian Lloyd Maagma</span>
          </span>
          <span class="hidden sm:block">Andrian Lloyd Maagma</span>
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <Link
          href="/cv"
          class="rounded-sm transition-all duration-300 ease-in-out hover:-translate-y-0.5"
          >cv</Link
        >
        <span>
          {`/`}
        </span>
        <Link
          href="/case-studies"
          class="rounded-sm transition-all duration-300 ease-in-out hover:-translate-y-0.5"
          >case studies</Link
        >
        <span>
          {`/`}
        </span>
        <Link
          href="/posts"
          class="rounded-sm transition-all duration-300 ease-in-out hover:-translate-y-0.5"
          >posts</Link
        >
        <span>
          {`/`}
        </span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="hover:text-accent-foreground focus-visible:text-accent-foreground flex items-center gap-1 rounded-sm p-0 text-xs transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:cursor-pointer"
        >
          <span class="hidden sm:inline">
            <kbd>Ctrl</kbd><kbd>K</kbd>
          </span>
          <Icon
            name="lucide:search"
            class="h-4 w-4 transition-colors duration-300 ease-in-out"
          />
        </button>
      </nav>
    </div>
  </Container>
</header>
