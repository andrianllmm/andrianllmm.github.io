---
import type { Achievement } from "@data/achievements";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  achievement: Achievement;
};

const { achievement } = Astro.props as Props;
---

<a
  href={`/achievements/${achievement.id}`}
  class:list={[
    "not-prose group flex h-full w-full flex-1 items-start gap-2 rounded-lg px-4 py-3 sm:items-center sm:gap-3",
    "hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground transition-all duration-300 ease-in-out",
  ]}
>
  {
    achievement.image && (
      <div class="text-muted aspect-video w-24 overflow-hidden rounded-lg text-xs sm:w-36 md:w-48">
        <img
          src={achievement.image}
          alt="Preview"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-1">
    <div class="line-clamp-2 font-semibold">{achievement.title}</div>

    {
      achievement.description && (
        <div class="line-clamp-1 text-sm text-wrap group-hover:line-clamp-6 sm:line-clamp-2">
          {achievement.description}
        </div>
      )
    }
    <div class="text-muted-foreground mt-0.5 flex gap-1 text-xs">
      <div class="text-accent-foreground font-medium">
        {achievement.position}
      </div>
      &bull;
      <div>
        {achievement.type}
      </div>
      &bull;
      <div>
        <FormattedDate
          date={new Date(achievement.date)}
          formatOptions={{ year: "numeric" }}
        />
      </div>
    </div>
  </div>
</a>
