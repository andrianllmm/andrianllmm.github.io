---
import type { Achievement } from "@data/achievements";
import FormattedDate from "./FormattedDate.astro";
import { resolveRelatedContent } from "@lib/relatedContent";

type Props = {
  achievement: Achievement;
};

const { achievement } = Astro.props as Props;

const { posts, caseStudies } = await resolveRelatedContent(
  achievement.relatedPosts,
  achievement.relatedCaseStudies,
);

const post = posts[0];
const caseStudy = caseStudies[0];
---

<div
  class="not-prose flex h-full w-full flex-col gap-1 rounded-lg border px-4 py-3"
>
  <div class="flex items-start justify-between gap-2">
    <div class="line-clamp-2 font-semibold">{achievement.title}</div>
    <span
      class="bg-accent text-accent-foreground shrink-0 rounded-full px-2 py-0.5 text-xs font-medium"
    >
      {achievement.position}
    </span>
  </div>

  <div class="text-muted-foreground flex flex-wrap gap-1 text-xs">
    <div>{achievement.organizer}</div>
    &bull;
    <div>{achievement.type}</div>
    &bull;
    <div>
      <FormattedDate
        date={new Date(achievement.date)}
        formatOptions={{ year: "numeric" }}
      />
    </div>
  </div>

  {
    (post || caseStudy) && (
      <div class="mt-auto flex flex-wrap items-center gap-1 pt-1 text-sm">
        <span class="text-muted-foreground">Read</span>

        {caseStudy && (
          <a
            href={`/case-studies/${caseStudy.id}`}
            class="text-accent-foreground inline-block underline transition-all duration-300 ease-out hover:-translate-y-0.5"
          >
            Case study
          </a>
        )}

        {caseStudy && post && <span class="text-muted-foreground">&bull;</span>}

        {post && (
          <a
            href={`/${post.collection}/${post.id}`}
            class="text-accent-foreground inline-block underline transition-all duration-300 ease-out hover:-translate-y-0.5"
          >
            Post
          </a>
        )}
      </div>
    )
  }
</div>
