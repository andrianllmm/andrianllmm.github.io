---
import { Icon } from "astro-icon/components";

interface Props {
  type?: "default" | "info" | "warning" | "destructive";
}
const { type = "default" } = Astro.props;

const icons = {
  default: "lucide:lightbulb",
  info: "lucide:info",
  warning: "lucide:alert-triangle",
  destructive: "lucide:alert-octagon",
};

const typeClasses = {
  default: "border-primary bg-primary/10 text-primary",
  info: "border-info bg-info/10 text-info",
  warning: "border-warning bg-warning/10 text-warning",
  destructive: "border-destructive bg-destructive/10 text-destructive",
};
---

<div
  class:list={[
    typeClasses[type],
    "not-prose my-4 flex items-start gap-3 rounded border p-3",
  ]}
>
  <Icon name={icons[type]} class="mt-1 h-4 w-4 flex-shrink-0 sm:h-5 sm:w-5" />
  <div class="text-sm leading-relaxed">
    <slot />
  </div>
</div>
