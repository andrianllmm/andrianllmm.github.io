---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import { Icon } from "astro-icon/components";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute -top-12 right-0">
        <BackToTop />
      </div>
    </div>
    <div
      class="flex flex-col flex-wrap items-end justify-center gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="order-2 text-xs text-nowrap sm:order-1">
        &copy; {new Date().getFullYear()} • {SITE.TITLE}
      </div>
      <div class="order-1 flex flex-nowrap items-center gap-1.5 sm:order-2">
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class="group hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground flex size-8 items-center justify-center rounded border"
        >
          <Icon
            name="lucide:sun"
            class="h-4 w-4 transition-colors duration-300 ease-in-out group-hover:animate-pulse group-focus-visible:animate-pulse"
          />
        </button>
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class="group hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground flex size-8 items-center justify-center rounded border"
        >
          <Icon
            name="lucide:moon"
            class="h-4 w-4 transition-colors duration-300 ease-in-out group-hover:animate-pulse group-focus-visible:animate-pulse"
          />
        </button>
        <button
          id="system-theme-button"
          aria-label="System theme"
          class="group hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground flex size-8 items-center justify-center rounded border"
        >
          <Icon
            name="lucide:monitor"
            class="h-4 w-4 transition-colors duration-300 ease-in-out group-hover:animate-pulse group-focus-visible:animate-pulse"
          />
        </button>
      </div>
    </div>
  </Container>
</footer>
