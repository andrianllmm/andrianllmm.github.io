---
import { getCollection } from "astro:content";
import { cn } from "@lib/utils";
import { tags, type TagKey } from "@data/tags";
import Badge from "./Badge.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const {
  tag,
  showNum = false,
  class: className = "",
} = Astro.props as {
  tag: TagKey;
  showNum?: boolean;
  class?: string;
};

const { name } = tags[tag];
const postCount = posts.filter((post) => post.data.tags?.includes(tag)).length;
---

<a href={`/tags/${tag}`}>
  <Badge
    indicator={showNum && postCount}
    class={cn("hover:-translate-y-0.75 transition-transform", className)}
  >
    #{name}
  </Badge>
</a>
