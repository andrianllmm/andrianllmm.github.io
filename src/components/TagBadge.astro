---
import { getCollection } from "astro:content";
import { cn } from "@lib/utils";
import { tags, type TagKey } from "@data/tags";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const {
  tag,
  showNum = true,
  className = "",
} = Astro.props as {
  tag: TagKey;
  showNum?: boolean;
  className?: string;
};
---

<a
  href={`/tags/${tag}`}
  class={cn(
    "transition-all hover:-translate-y-0.75 flex items-center gap-1 rounded border px-1.5 py-0.75 text-sm duration-300 ease-in-out hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground",
    className,
  )}
>
  <span>#{tags[tag].name}</span>
  {
    showNum && (
      <div class="relative">
        <span
          class={cn(
            "absolute -right-1 -bottom-1 translate-x-1/2 -translate-y-1/2",
            "bg-background text-border flex h-4 w-4 items-center justify-center rounded-full",
          )}
        >
          {posts.filter((post) => post.data.tags?.includes(tag)).length}
        </span>
      </div>
    )
  }
</a>
