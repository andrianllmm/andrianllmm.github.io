---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  author?: string;
  publishedDate?: Date;
  modifiedDate?: Date;
  type?: "website" | "article";
  keywords?: string[];
};

const {
  title,
  description,
  image,
  author,
  publishedDate,
  modifiedDate,
  type,
  keywords,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      author={author}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      type={type}
      keywords={keywords}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <Pagefind />
  </body>
</html>
